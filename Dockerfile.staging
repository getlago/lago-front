# syntax=docker/dockerfile:1.28

# Staging-only hardened image built for SOC2 compliance. FROMs the Wolfi/apko
# bases published by getlago/lago-packages to GHCR; they are public, so no
# registry credentials are needed to build this file. The legacy ./Dockerfile
# stays untouched and continues to serve production builds; only the staging
# pipeline (lago-deploy's build-front-staging-image.yml) points here.

# BASE PIN: `:<YYYYMMDD>-r<run>@sha256:<index digest>`, an immutable
# lago-packages publish. Docker builds from the digest, so a build is
# reproducible. Renovate (getlago/lago-packages renovate/lago-bases) moves tag
# and digest together when a newer base is published; the base refresh
# rebuilds deployed tags with a newer RUNTIME_IMAGE in between.
ARG BUILD_IMAGE=ghcr.io/getlago/lago-front-build:20261101-r1190@sha256:aab3800143d82a45c87161a285b43dc9a5a441c8d85a7d961472cd9acfecd140
ARG RUNTIME_IMAGE=ghcr.io/getlago/lago-front-base:20261101-r1189@sha256:34ee92d5a11ad38e7b1cbd96594b83f014f1c5d8fd2f13d1124fb31c0fcf932d

# --- deps stage --------------------------------------------------------------
FROM ${BUILD_IMAGE} AS deps

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/configs/package.json        ./packages/configs/
COPY packages/design-system/package.json  ./packages/design-system/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --ignore-scripts


# --- build stage -------------------------------------------------------------
FROM ${BUILD_IMAGE} AS build

WORKDIR /app
ENV NODE_OPTIONS="--max-old-space-size=4096"

COPY --from=deps /app /app
COPY . .

ARG SENTRY_DSN
ARG SENTRY_ORG
ARG SENTRY_FRONT_PROJECT
ARG APP_VERSION
ENV APP_VERSION=$APP_VERSION

RUN --mount=type=secret,id=sentry_auth_token,env=SENTRY_AUTH_TOKEN \
    pnpm build


# --- runtime stage: hardened Wolfi nginx -------------------------------------
FROM ${RUNTIME_IMAGE}

WORKDIR /usr/share/nginx/html

COPY --from=build /app/dist .
COPY ./nginx/nginx.main.staging.conf /etc/nginx/nginx.conf
COPY ./nginx/nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY ./nginx/gzip.conf /etc/nginx/conf.d/gzip.conf
COPY ./nginx/csp.conf.template /etc/nginx/csp.conf.template
COPY ./.env.sh ./.env.sh

# Everything nginx writes goes to the /tmp emptyDir the pod mounts: the pid
# file, the temp paths (both in nginx.main.staging.conf) and env-config.js,
# which .env.sh emits into its cwd. The dist stays read-only and unmounted —
# an emptyDir over it would mask the built assets.
# Files stay root-owned so nginx cannot rewrite them.
USER 65532

EXPOSE 8080

ENTRYPOINT ["/bin/bash", "-c", "cd /tmp && /usr/share/nginx/html/.env.sh && exec nginx -e /dev/stderr -g \"daemon off;\""]
