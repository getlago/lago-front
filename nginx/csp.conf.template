# Security headers. This file is a TEMPLATE, not a loaded config.
#
# `.env.sh` substitutes the `__LAGO_*__` placeholders and writes the result to
# /tmp/csp.conf at container start. That rendered file is what every location
# in nginx.conf includes. The image ships this template at
# /etc/nginx/csp.conf.template, outside conf.d, so nginx never loads it raw.
#
# `frame-ancestors` is the one directive that differs per deployment, so
# `LAGO_FRAME_ANCESTORS` overrides it. It defaults to `'self'`: only this app
# may frame itself. A deployment that embeds Lago elsewhere sets the variable
# and lists its own origins. See `.env.sh` for the format.
#
# If the substitution ever fails, the literal placeholder stays in the header.
# Browsers ignore a source expression they cannot parse, so the policy then
# allows no ancestor at all. It fails closed.
#
# `connect-src` and `frame-src` gate where the app may send data and which
# frames it may load. The hosts the app talks to at runtime (the API and its
# `wss://` ActionCable socket, the Sentry DSN, Nango, the embedded Superset)
# differ per deployment, so `.env.sh` renders these two directives too.
# `LAGO_CSP_SOURCES` picks the mode:
#
#   open         (default) any https:/http:/wss:/ws: origin, as before. A
#                self-hosted deployment keeps working with no new variable.
#   report-only  `open` stays enforced. A second header,
#                Content-Security-Policy-Report-Only, carries the strict
#                sources and reports what they would block.
#   enforce      the strict sources are enforced.
#
# The strict sources are derived from API_URL (or LAGO_DOMAIN), SENTRY_DSN,
# NANGO_PUBLIC_KEY and LAGO_SUPERSET_URL. See `.env.sh`.
#
# The defense-in-depth that applies in every mode is where *scripts* execute:
# script-src 'self' (the app only loads its own hashed /assets bundles +
# env-config.js, with no inline scripts and no eval), object-src 'none', and
# base-uri 'self'.

add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src __LAGO_CONNECT_SRC__; worker-src 'self' blob:; frame-src __LAGO_FRAME_SRC__; object-src 'none'; base-uri 'self'; frame-ancestors __LAGO_FRAME_ANCESTORS__;" always;

# Stop browsers MIME-sniffing a response into an unexpected (e.g. executable)
# content type.
add_header X-Content-Type-Options "nosniff" always;

# Don't leak full URLs (which can carry org slugs / ids) to third-party
# origins; send only the origin on cross-origin requests, nothing on downgrade.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# NOTE: deliberately NO X-Frame-Options header. Lago is intentionally embedded
# by partner origins (see the frame-ancestors allowlist above), and X-Frame-
# Options has no allowlist value: SAMEORIGIN/DENY would break those embedders
# in browsers that honor XFO, and the deprecated ALLOW-FROM is unsupported.
# CSP frame-ancestors is the modern, allowlist-capable clickjacking control
# and already covers this case, so XFO would only regress behaviour.
