{
  "name": "lago-ui",
  "version": "0.0.0",
  "description": "Lago v2 design system",
  "repository": "git@gitlab.com:getlago/lago-front.git",
  "author": "Lago tech team <tech@getlago.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": "./src/components/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./tailwind-preset": "./tailwind-preset.ts"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "types": "tsc --noEmit",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:docs": "node --test scripts/docs.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-separator": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "class-variance-authority": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "babel-jest": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "lago-configs": "workspace:*",
    "postcss": "catalog:",
    "postcss-preset-env": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
