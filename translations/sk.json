  "text_17830875698228lpz4i09jop": "Počet fakturačných období: {{count}}|Počet fakturačných období: {{count}}",
  "text_1783090333139dnllq2q6ege": "Výška zľavy",
  "text_1783352692385rxn8gajgtw4": "Predplatené kredity",
  "text_1783352692385djf5dxfo8l5": "Zahrňte do tejto ponuky bezplatné alebo platené kredity. Nastavte spôsob ich uplatňovania a čerpania.",
  "text_17833526923851igosmn1oar": "Nastavenia kreditov a peňaženky",
  "text_1783352692385hz7bj9un6gr": "Zadajte údaje peňaženky, aby sa dala ľahko identifikovať.",
  "text_178335269238576yarvlompv": "Obmedzenie použitia peňaženky",
  "text_1783352692385a04ln0put4m": "Kredity z peňaženky sa štandardne uplatňujú na všetky položky faktúr za predplatné. Ak chcete väčšiu kontrolu, obmedzte ich použitie.",
  "text_1783352692385e6ttj3xne6k": "Bezplatné a platené kredity",
  "text_17833526923856caxxme9l8x": "Určite výšku bezplatných alebo platených kreditov zahrnutých v tejto ponuke.",
  "text_1783352692385mulfe6vb211": "Pravidlo opakovaného dopĺňania peňaženky",
  "text_1783352692385xcnr96jj40l": "Nastavte automatické dopĺňanie v určenom intervale alebo pri dosiahnutí stanovenej hranice.",
  "text_1783352692385g9pml8ryold": "Vybrať kredity",
  "text_1783352692386xocpgvrz3na": "Kredity",
  "text_1783352692386nm1wsx38b6v": "Pridať do tejto ponuky predplatené kredity",
  "text_17833526923863j848qxkffb": "Nastavenia peňaženky",
  "text_17841895626504bixbm3xbyj": "Zobrazte podrobnosti tejto vykonanej objednávky vrátane nastavení vykonania a obsahu.",
  "text_17842142209100wegryv1st3": "Faktúra {{invoiceNumber}} bola odstránená",
  "text_17848001862070vhaaoyut3y": "Odstrániť faktúru",
  "text_17848001862071abwcvd3b3p": "Chystáte sa odstrániť tento koncept faktúry",
  "text_1784800186207jjeqsv1d0rd": "Tento koncept faktúry bude natrvalo odstránený a nikdy sa nestane pohľadávkou. Túto akciu nemožno vrátiť späť. Naozaj chcete pokračovať?",
  "text_1784800186207ionjr7ey3jq": "Koncept faktúry bol úspešne odstránený",
  "text_178482400457029nb9diwj6m": "Odstrániť koncept faktúry",
  "text_1731423623190elua4pl3ccr": "Toto predplatné ešte nie je aktívne. Spotreba za celé obdobie sa zobrazuje iba pri aktívnych predplatných.",
  "text_636d023ce11a9d038819b579": "Vyskytla sa chyba",
  "text_636d023ce11a9d038819b57b": "Obnovte stránku. Ak chyba pretrváva, kontaktujte nás.",
  "text_1739804207625v7faokht1cq": "Zatiaľ nebola zaznamenaná žiadna spotreba za celé obdobie",
  "text_1739804207625nkct7jhmmwh": "Pri načítavaní spotreby za celé obdobie sa vyskytla chyba. Skúste to znova.",
  "text_1778680248317x4cg78xappu": "Spotreba priradená k poplatku",
  "text_17848821795797viukiwsvkd": "Opakované dopĺňanie",
  "text_1784882179579jrpo7xq992a": "Jednorazovo",
  "text_1784882179579muknx9hd8bw": "Bezplatne",
  "text_1784882179579v64foe5ytas": "Platnosť do {{date}}",
  "text_1784882179580txsoj9pf51f": "Platí pre {{scope}}",
  "text_1784882179580hb24cd5e4jc": "Platí pre všetky poplatky",
  "text_17848821795809xtwzsq7ot9": "Pri nízkom zostatku",
  "text_178488217958075syit8qyd5": "Najviac {{count}}",
  "text_1784883525803ne7j9k70cy2": "Bezplatné kredity",
  "text_1784883525803oz45f5x0ier": "Poplatky za spotrebu",
  "text_1784883525803dqcjtvdskqq": "Poplatky za záväzok",
  "text_1784883525803z2r3s9910of": "Poplatky za predplatné",
  "text_1784883525803lunzztlh547": "Mesačne",
  "text_1784883525803zcmgdkvi3vd": "Štvrťročne",
  "text_1784883525803guz1xdk6ub7": "Týždenne",
  "text_17848835258036aevge8fx0s": "Polročne",
  "text_1784883525803ghc0vq94t5u": "Ročne",
  "text_1787723331045u6dbfhsdn6n": "Pevné poplatky",
  "text_1792713576578hbdtwgcoy2a": "Niektoré údaje môže zmeniť iba váš poskytovateľ. Ak ich potrebujete aktualizovať, kontaktujte ho.",
  "text_1793265036704cnkqwk0atap": "Toto pole je príliš dlhé. Môže obsahovať najviac 255 znakov.",
  "text_17932959847757c9xwcz2ltv": "Toto pole je príliš dlhé. Môže obsahovať najviac 500 znakov.",
  "text_1793265036704k3gcjfhp5lo": "Toto pole obsahuje nepovolené znaky, napríklad zalomenia riadkov, tabulátory alebo neviditeľné znaky."
}
